{
  "expo": {
    "name": "Kampüs Erişilebilirlik",
    "slug": "kampus-erisilebilirlik",
    "owner": "kampus-erisilebilirlik",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "tr.edu.selcuk.kampuserisim",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "En yakın erişilebilir noktayı bulmak için konumunuz yalnızca telefonunuzda kullanılır, sunucuya gönderilmez."
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "Eğim ölçümü için ivmeölçer sensörüne erişim gereklidir."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ]
    ],
    "scheme": "kampuserisim",
    "extra": {
      "eas": {
        "projectId": "d6aec9f5-64d9-47f5-b1d2-dc13faf25f5c"
      }
    }
  }
}
